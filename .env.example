# ====================== LLM & 搜索API密钥（部署时填入自己的key） ======================
# deepseek
DEEPSEEK_API_KEY=

# 阿里云通义
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=

# tavily web_search引擎
TAVILY_API_KEY=

# langsmith 链路追踪
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agent-project

# 阿里OSS 对象存储
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=

# ====================== 后端服务地址（可根据实际环境修改） ======================
# 请求java后端服务地址
SHOP_SERVICE_URL=http://localhost:8082
BLOG_SERVICE_URL=http://localhost:8081
VOUCHER_SERVICE_URL=http://localhost:8084

# 默认用户经纬度
DEFAULT_LONGITUDE=
DEFAULT_LATITUDE=

# Agent配置
AGENT_MODEL=
AGENT_EVAL_STRICT=true
AGENT_SUMMARY_MODE=structured
AGENT_HISTORY_KEEP=8
AGENT_MAX_SHOPS=3
AGENT_NEARBY_TOP=5
AGENT_MAX_SOURCE=3
AGENT_SSE_DELTA=false
AGENT_SSE_STATUS=true
AGENT_LIGHT_MODEL=
AGENT_TEMPERATURE=0.1

# mcp服务开关
ENABLE_TIME_MCP=true
ENABLE_KIWI_MCP=false

# 业务参数
BLOG_PAGE_SIZE=100
DEFAULT_SEARCH_RADIUS=50000

# ====================== RAG相关配置 ======================
RAG_HYBRID=true
RAG_EXPAND_QUERY=true
RAG_RERANK=true
RAG_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
RAG_MQ_SYNC=true
RAG_SYNC_QUEUE=agent.rag.sync.queue
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=5
RAG_BM25_REBUILD_DELAY=5

# ====================== RabbitMQ ======================
RABBITMQ_CACHE_SYNC_EXCHANGE=cache.sync.fanout
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=

# 跨域设置
CORS_ORIGINS=http://localhost:3000

# ====================== Nacos 配置 ======================
NACOS_SERVER_ADDRS=
NACOS_NAMESPACE=
NACOS_SERVICE_NAME=agent-service
NACOS_GROUP_NAME=DEFAULT_GROUP
NACOS_USERNAME=
NACOS_PASSWORD=

# Agent自身服务地址
AGENT_IP=
AGENT_PORT=
AGENT_HOST=0.0.0.0

AGENT_CHECKPOINT_BACKEND=redis
AGENT_CHECKPOINT_KEY_PREFIX=agent:checkpoint
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=0
# 想直接用完整连接串时打开下面这行（优先级高于上面的分项配置）
# 仅当 AGENT_CHECKPOINT_BACKEND=sqlite 时生效
AGENT_CHECKPOINT_SQLITE_PATH=db/hmdp_agent.db

# ---------------------------------------------------------------------------
# agent 的存储（sessions 会话元数据 + agent_message 会话消息）
#   原来是本地 SQLite（db/sessions.db），多实例部署各存各的；现改为 MySQL 独立库
#   `hmdp_agent`，与 Java 侧同一个 MySQL 实例（连接信息见 Nacos 的 shared-jdbc.yaml）
# ⚠️ 代码不建库、不建表：库/表由部署方执行 sql/agent_session.sql、sql/agent_message.sql 创建
#    应用启动时只校验表是否存在，缺失会 fail fast 并提示脚本路径（清单见 sql/README.md）
# ---------------------------------------------------------------------------
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=hmdp_agent
MYSQL_POOL_MIN=1
MYSQL_POOL_MAX=5