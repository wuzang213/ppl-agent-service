# LLM
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ⚠️ 留空 = **必须显式选一个**（`llm.py` 用 `require_env`，缺值启动即失败）。
#    模板曾写死 `qwen-plus`，而该模型当前 403 额度耗尽 ⇒ 照模板配的人一启动就撞额度错误。
AGENT_MODEL=
# ⚠️ 与 AGENT_MODEL 同属 llm.py 的 require_env 硬要求（无代码内回退），**漏配则启动即失败**。
#    本键曾漏登记于本清单（清单自称"变量清单的唯一可提交来源"），2026-10-04 补登。
AGENT_LIGHT_MODEL=
# 🔴 本键被**入口路由 / 品类归类 / 细分筛选 / 抽槽 / 闲聊 / ReAct 决策**共用，
#    所以「换更快的模型」**不能只看延迟** —— 2026-10-06 实测两个更快的候选都不合格：
#      · qwen-turbo：`SlotFill`（抽槽）结构化调用 **>25s 卡死**（3/3 复现）⇒ 澄清环节不可用；
#      · qwen-flash：抽槽乱填 `people=0/budget=0`；入口路由 90.8%，其中 **plan 轨命中 0%**、
#                    比价 `depends_on` 仅 25% ⇒ 行程轨与比价都判不出来。
#    ⇒ 换之前**必须**跑 `app/tests/manual_light_model_quality.py`（报命中率，N≥6），
#      而不是只测「能不能返回结构化结果」—— turbo 能返回纯文本、也能做品类归类，唯独抽槽卡死。
#    ⚠️ **别一次跑"全套 × N≥6 × 多模型"**（2026-10-09 踩过）：那是 **144 次**调用，
#      会把 DashScope 免费额度打爆（`403 AllocationQuota.FreeTierOnly`，15min 超时），
#      而**失败会被计成 miss** ⇒ 打出的命中率是**被污染**的，不能当结论。
#      建议：**单模型 + `--only D`**（换模型后最易悄悄坏掉的三处：SubcategoryPick / ItineraryPlan /
#      bind_tools(ReAct)）先跑一轮，够用再补 A/B/C。
#    📌 2026-10-09 现状：`AGENT_LIGHT_MODEL=qwen3-max-preview` —— `manual_model_capability` 通过
#      （可用 1.0s、`RoutePlan` 结构化字段全对），**六通道准确率闸门尚未完整跑过**（额度受限）。
#
# 🔴 `AGENT_SLOT_MODEL`：**抽槽（`SlotFill`）专用**，留空 = 跟 `AGENT_MODEL` 走。
#    为什么要单独一个角色：轻量模型被**六个**通道共用，而 2026-10-06 六通道实测显示
#    「更快的模型」只在这一个通道不合格（qwen-turbo >25s 不返回），其余五个全绿且快 10~30 倍
#    （详见 app/agents/graph/llm.py 的 DEFAULT_SLOT_MODEL 注释表）。
#    抽槽每轮澄清只调 1 次、**不在热路径**，用主模型的 5~6s 可以接受。
#    ⚠️ 用 `or` 回落而不是 `os.getenv(k, default)`：空串不会触发 getenv 的默认值。
AGENT_SLOT_MODEL=
# 采样温度（纯调参，两个角色共用）；缺省 0.1
AGENT_TEMPERATURE=0.1

# 🔴 `AGENT_ENABLE_THINKING`：模型**思考模式**开关，缺省 `false`（即下发 `enable_thinking=false`）。
#    为什么默认关（2026-10-08 实测，同一份 prompt）：
#      思考开 → 13.16s，output_tokens=908，其中 reasoning=**821**
#      思考关 → **2.14s**，output_tokens=77，reasoning=0
#    思考 token **不产出正文**却照样逐 token 占时间 ⇒ 用户侧表现为"首字 10s+、半天不打字"，
#    而终答只有两三百字。关掉后答案内容无实质差异。
#    ⚠️ 真机排查"回复慢"时**先看这一项**：取数侧并不慢（RAG 0.25s / Java detail 0.05s / 券 0.15s）。
AGENT_ENABLE_THINKING=false

# 历史上下文预算（trim_history 的压缩触发 + daily_chat 的注入窗口共用这一条口径）：
#   AGENT_HISTORY_TOKEN_BUDGET=3000 上下文里保留/注入的估算 token 上限（超出即把更老部分压成滚动摘要；daily_chat 只注入该预算内的最近消息）
#   AGENT_HISTORY_ESTIMATE_FACTOR=1.0 估算 token 相对真实 token 的校准系数（压缩前后估算值记在 tools_called，形如 history_trim:5200->1600）
AGENT_HISTORY_TOKEN_BUDGET=3000
AGENT_HISTORY_ESTIMATE_FACTOR=1.0

# token 估算实现（specs/0020）：默认 CJK 估算（零依赖，单测/离线无需装包）；
#   USE_TIKTOKEN_ESTIMATE=false 置 true 走 tiktoken 真实计数 —— 需装可选依赖 `token-estimate`（uv sync --extra token-estimate）。
#     🔴 打开后 tiktoken 分支返回**真实 token**（不再乘 AGENT_HISTORY_ESTIMATE_FACTOR；该系数只作用于 CJK 估算）；
#        tiktoken 不可用时**安全回落** CJK，不报错。
#   TIKTOKEN_ENCODING=cl100k_base tiktoken encoder（模型级可配）
USE_TIKTOKEN_ESTIMATE=false
TIKTOKEN_ENCODING=cl100k_base

# 搜索与观测
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agent-project

# 阿里 OSS（示例代码使用）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=cn-beijing
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com


# Java 微服务地址（本地开发）
SHOP_SERVICE_URL=http://localhost:8082
BLOG_SERVICE_URL=http://localhost:8081
VOUCHER_SERVICE_URL=http://localhost:8084
# 站内搜索服务（specs/0026）：细分词用博客全文反查店铺时调用 `GET /search/blog`。
# ⚠️ 留空 ⇒ 该补充召回工具返回「信息暂时查不到」⇒ 主链路按降级处理（不影响原有召回）。
SEARCH_SERVICE_URL=http://localhost:8085
BLOG_PAGE_SIZE=100

# 默认坐标（未传 x/y 时使用）
DEFAULT_LONGITUDE=120.149192
DEFAULT_LATITUDE=30.316078
# 「附近」的距离过滤半径（米）。⚠️ 必须与上面的坐标**同城**，否则整座城被筛掉、悄悄退化成"按店名搜"
DEFAULT_SEARCH_RADIUS=50000

# 提示词「评测严格模式」（`prompts.EVAL_STRICT`，缺省 true）：
# 开启后追加严格规则——只回答用户问的那件事、缺字段如实说"暂未获取"、不编造。
# ⚠️ 它**不是**只给评测用：关掉后模型会主动推荐/追问，口径会变松。
AGENT_EVAL_STRICT=true

# 每家店带进上下文的探店博客条数（多了挤占 token，且博客质量参差）
AGENT_CONTEXT_BLOGS=3
# 跨轮焦点（focus_shops）最多沉淀多少家店；超出的旧焦点不再带入后续轮次
AGENT_FOCUS_MAX=10
# 摘要投影（[已推荐]/[死路]）的跨轮上限（specs/0016 §10.3）：超出的旧条目丢最早的
AGENT_DIGEST_MAX=10

# MCP 工具开关
ENABLE_TIME_MCP=true
ENABLE_KIWI_MCP=false

# 扇出资源上限（specs/0005 §4 验收 2/3/4）：没有上限时"比这五家的详情、优惠和攻略"会展开 5×3=15 个 worker，瞬时打满 DB/ES。
# ⚠️ 上限作用在「任务数 × 店铺数」的乘积上，不是店铺数（3 店 × 1 意图 = 3，正常不触发）。
AGENT_MAX_FANOUT=8
# 单个 worker 取数超时（秒）。⚠️ 语义是**降级**不是失败：超时记 failed，本轮照常出答案
AGENT_WORKER_TIMEOUT=12
# 熔断（pybreaker，specs/0022/plans/0038）：同一类 worker 连续失败达此数即打开熔断，后续同类**直接短路**（不再发起实际调用）
AGENT_FANOUT_FAIL_THRESHOLD=3
# 熔断冷却窗口（秒）：打开后经此时间**自动放行一次探测**，探测成功即关闭、失败则重开（可自动恢复，无需重启进程）
AGENT_FANOUT_BREAKER_COOLDOWN=30
# 参与扇出的**店铺数**上限（与上面的任务数上限相乘才是实际 worker 数）
AGENT_MAX_SHOPS=3
# 「附近找店」一次返回的候选条数（送进汇总模型前会按细分品类再筛）
AGENT_NEARBY_TOP=5
# 多活动/多类型（specs/0030 / plans/0048）：recommend 轨一次最多解析的**类型/活动**数（`RoutePlan.shop_types`）。
#   超出上限的活动不会取数，只会进【未覆盖】如实说"尚未查询"；默认 3，**调用时读**。**改它需重启服务**。
AGENT_NEARBY_MAX_TYPES=3
# 细分品类/食材召回（specs/0026 / plans/0041）：细分词（"牛油果""手冲咖啡"）在**原链路（类型搜 + 名称搜）
#   都为空**时，经 search-service 用**博客全文**反查命中店铺，补进候选（与原候选按 shop_id 去重后统一排序）。
# ⚠️ 关闭本开关 / 或清空 SEARCH_SERVICE_URL ⇒ 完全回原链路（行为与改造前一致）。
AGENT_BLOG_RECALL_ENABLED=true
# 反查时透传给 search-service 的 size（命中博客条数上限）；默认 5
AGENT_BLOG_RECALL_SIZE=5
# 单轮最多补全的店铺数（shop-service **无批量接口** ⇒ 逐条 GET /shop/{id}）；默认 5，受 AGENT_FANOUT_CONCURRENCY 约束
AGENT_BLOG_RECALL_MAX=5
# recommend 轨**多方案**（specs/0027 / plans/0044）：用户的软偏好（`RoutePlan.preferences`）含 **≥2 个维度**时，
#   按每个维度各出一套方案（"最便宜"/"评分最高"/"离得最近"…），随 SSE 的 `schemes` 事件下发；
#   ⚠️ **只加字段**：原有 `shops` 完整保留，旧前端不受影响。关闭 / 维度 <2 ⇒ 回单方案（行为同 0043）。
AGENT_MULTI_SCHEME_ENABLED=true
# 最多几套方案（维度数超上限时按 preferences 优先级截取）；默认 3
AGENT_MULTI_SCHEME_MAX=3
# 每套方案最多几家（条数不固定，可少于该值）；默认 5
AGENT_MULTI_SCHEME_ITEMS=5
# 答复里最多引用几个来源（`source` 数组长度上限）
AGENT_MAX_SOURCE=3

# ReAct 补跳（specs/0005 §5.5）：只对"必须看完一批候选才能确定是哪家"的请求生效（如"比这三家，再把最便宜那家的券列出来"）；环内只允许只读工具，写操作（下单/领券/支付）永不进环。
# AGENT_REACT_MAX_STEPS 是补跳最大步数，到上限强制收敛并打日志 react_loop_truncated。
AGENT_REACT_MAX_STEPS=6
# 单步内**最多并行调几个工具**（`tool_calls` 是列表 ⇒ `asyncio.gather` 并行执行）
AGENT_REACT_MAX_TOOLS_PER_STEP=2

# 稀疏检索后端（ES）：RAG 的稀疏侧不自建 BM25，直接查 broker 侧已有的 blog 索引（别名 hmdp_blog）。
# ⚠️ **与其它 AGENT_* 变量语义不同**：这里缺失/连不上不崩溃，而是降级为只用向量侧、只打 warning；要启用 ES 稀疏检索就必须填 ES_HOST。
ES_HOST=
ES_PORT=9200
ES_BLOG_ALIAS=hmdp_blog
# ES 稀疏检索超时（秒）；超时即降级，不阻塞主链路
ES_SPARSE_TIMEOUT=3

# rag
RAG_HYBRID=true
RAG_EXPAND_QUERY=true
# ⚠️ 重排开关（A/B 对比用，默认关，改它不需要动代码）：开启代价为 CPU 推理 2.3–6.6 s/次 ⇒ 单个 compare 类请求最多 +13s，关闭后 rag 稳态仅 320ms。已按决策关闭（specs/0010 §9 问题 8）。
# 模型只在首次调用时加载一次（local_files_only=True 不联网，实测 1.67s）后常驻；值不值取决于排序质量提升能否抵消这几秒，待开/关对照评测再定（specs/0010 §9 问题 8）。
RAG_RERANK=false
RAG_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
RAG_MQ_SYNC=true
RAG_SYNC_QUEUE=agent.rag.sync.queue
RAG_TOP_K=5
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=80

# rabbitmq
RABBITMQ_CACHE_SYNC_EXCHANGE=cache.sync.fanout
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=

# ip白名单
CORS_ORIGINS=http://localhost:3000

# nacos
NACOS_SERVER_ADDRS=
NACOS_NAMESPACE=
NACOS_SERVICE_NAME=agent-service
NACOS_GROUP_NAME=DEFAULT_GROUP
# agent **出站**调用的服务名（不是自己注册的名字）；agent-service 不读 Nacos 配置，
# Nacos 对它只是服务注册/发现的地址簿，这些名字用于拼 `lb://<name>/...`
NACOS_SHOP_SERVICE=shop-service
NACOS_BLOG_SERVICE=blog-service
NACOS_VOUCHER_SERVICE=voucher-service
# 服务列表刷新间隔（秒）
NACOS_DISCOVERY_REFRESH=10
NACOS_USERNAME=
NACOS_PASSWORD=


AGENT_IP=
AGENT_PORT=8001

AGENT_HOST=0.0.0.0

# Agent checkpoint 后端：redis（默认，进程外共享、多实例同 thread_id 都能读到历史、容器重建不丢）/ sqlite（回退，本地文件、多实例各存各，仅本地调试）。
# 只用 Hash/ZSet/Set 等基础命令，不需要 Redis 带 RediSearch/RedisJSON 模块。
AGENT_CHECKPOINT_BACKEND=redis
AGENT_CHECKPOINT_KEY_PREFIX=agent:checkpoint
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 想直接用完整连接串时打开下面这行（优先级高于上面的分项配置）
# AGENT_CHECKPOINT_REDIS_URL=redis://:password@host:6379/0
# 仅当 AGENT_CHECKPOINT_BACKEND=sqlite 时生效
AGENT_CHECKPOINT_SQLITE_PATH=db/hmdp_agent.db

# agent 存储（sessions 会话元数据 + agent_message 会话消息，MySQL 独立库 hmdp_agent，与 Java 侧同一个 MySQL 实例）。
# ⚠️ 代码不建库不建表：库/表由部署方执行 sql/agent_session.sql、sql/agent_message.sql；应用启动只校验表存在，缺失即 fail fast 并提示脚本路径（见 sql/README.md）。
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=hmdp_agent
MYSQL_POOL_MIN=1
MYSQL_POOL_MAX=5

# SSE 输出形态：AGENT_SSE_STATUS=true 推 status（节点进度骨架）、AGENT_SSE_DELTA=true 推 delta（最终答案逐 token）；结尾总会额外发一条 message（完整答案）+ 一条 done。
# ⚠️ 只有 summarize_answer / daily_chat 的 token 会被转发（见 hmdp_agent.STREAM_NODES）；关掉 DELTA 等于退回一次性完整答案、前端没有打字机效果。
AGENT_SSE_DELTA=true
AGENT_SSE_STATUS=true

# 行程摘要进对话记忆的字符上限（specs/0012 §11.4）：结构化明细走 agent_message.payload，正文只留摘要。
# ⚠️ 超限时**显式**追加"（更早的内容已省略）"，不静默截断。
AGENT_PLAN_ANSWER_MAX_CHARS=400
# recommend 轨写回 state.messages 的正文摘要上限（specs/0016 §8 Q6）：`answer` 全文仍用于 SSE 与 DB content，
# 只有**进模型上下文**的那份被压成摘要（整个 AIMessage ≤ 350 字，不是每家店）。
# 🔴 为什么要有：多轮 recommend 原先把完整正文写回 messages ⇒ 累积长正文、触发频繁压缩。
AGENT_RECOMMEND_DIGEST_MAX_CHARS=350

# 计划轨（specs/0012 §10/§11）：行程规划的开关与闸门。
# ⚠️ **默认 false** —— 它只决定"判成 plan 之后是否真走规划轨"：关着时判据与闸门照跑，但结果一律
#   回落 recommend，所以**行为与不开启时完全一致**（用于"先合判据、后接线"）；`0016` 接好节点后再打开。
AGENT_PLAN_ENABLED=false
# 入口二次校验（specs/0012 §10.4）：模型判了 plan，但 query 里**可验证痕迹**（时间序列 / ≥2 类消费场景 /
#   区域词）不足 2 类时强制回落 recommend。默认 true —— 这是防止"简单问句被误判成行程"的确定性闸门。
AGENT_PLAN_GUARD_ENABLED=true
# 每站最多带几条**证据**（`plans/0020` §15.1）：取自博客检索块的原文片段，前端要逐条展示。
# ⚠️ 检索带 Cross-Encoder 重排，是全链路唯一会秒级阻塞的取数块（`specs/0010`）⇒ 宁少勿多。
AGENT_ITINERARY_EVIDENCE_MAX=2
# 同一轮预约里最多允许改几次（`plans/0021` §16.2）。超过就不再挂起确认卡、交回入口。
# 🔴 没有它 ⇒ 前端 bug 反复发 `modify` 会**无限挂起**，用户永远结束不了这一轮。
AGENT_BOOKING_MODIFY_MAX=3
# task_draft 的 TTL：连续多少轮未提及行程即自动清空（另两种清理是"显式结束"与"换个话题"）。
AGENT_TASK_TTL_TURNS=3
# 澄清重试上限（specs/0012 §12.3.3）：连续这么多轮都没给出有效槽值时，**弃权**——清掉 task_draft、
# 把用户那句话交回入口当新回合重路由（避免"听不懂就无限追问"的死循环）。
AGENT_CLARIFY_MAX_RETRY=2
# 行程最多几站（specs/0012 R2）：行程越长，载荷与后续渲染越贵；超出即截断。
AGENT_ITINERARY_MAX_STOPS=6
# 计划轨每个场景取几家候选？够编排用即可（取数 = 每场景 1 次附近 + 每家 1 次详情 + 1 次券）。
AGENT_PLAN_CANDIDATES_PER_SCENE=3
# 计划轨最多同时安排几个场景（防止"逛吃看玩买"一次全上）。
AGENT_PLAN_MAX_SCENES=3

# ============================================================================
# 运行账本（specs/0013）：一次请求 1 行 run + 每次模型/工具调用各 1 行，按 run_id 关联
# ============================================================================
# ⚠️ 建表脚本：**必须**先执行 `sql/agent_ledger.sql`（三张表登记在 main.REQUIRED_TABLES，
#    缺表**启动即失败**）。只停写入、不删表用 `AGENT_LEDGER_ENABLED=false`。
# 🔴 账本是**旁路**：写库失败只记 warning，绝不影响本轮答复。
AGENT_LEDGER_ENABLED=true
# 后台批量落库：攒够这些条 / 或距上次刷写超过这些毫秒，就写一次
AGENT_LEDGER_BATCH_SIZE=50
AGENT_LEDGER_FLUSH_MS=500
# provider usage 锚点（压缩决策改用真实 prompt token；指纹不匹配/消息变少即回退本地估算）。
#   🔴 锚点由**节点自查模型返回的 usage**得到（specs/0013 §11.1），**不经回调** ——
#      回调里写 ContextVar 在异步链路上落进别的上下文，锚点会恒为空（见
#      bug/BUG-20261009-usage-anchor-dead-on-async-path.md）。关掉本开关即整体回退本地估算。
#   ⚠️ 依赖 `llm._build_one` 的 `stream_usage=True`：不显式索要时流式 usage 取决于模型名
#      （qwen3-max-preview 流式默认不给 ⇒ daily 轨与六个轻量通道的 token 会恒为 0）。
AGENT_USAGE_ANCHOR_ENABLED=true
# 上下文捕获（specs/0017 T2，默认**开**）：是否把 query 原文 / 意图路由（scene/sub_intents/
#   depends_on）/ 卡片必填字段写进账本，供之后从账本冻结**行为回归集**。
#   ⚠️ 都是对已有行的一次 UPDATE（非高频插入）；默认关则二期数据永远攒不起来。
#   ⚠️ 需要先执行 sql/agent_ledger_add_context.sql（六列登记在 main.REQUIRED_COLUMNS，缺列启动即失败）。
AGENT_LEDGER_CAPTURE_CONTEXT=true

# ============================================================================
# Tier 2 韧性与容量（specs/0014）
# ============================================================================
# 计划轨**编排**专用模型。留空 = 回落到 AGENT_LIGHT_MODEL（行为与不配完全一致）。
# ⚠️ 该模型必须支持 with_structured_output，否则编排失败并走规则兜底。
AGENT_PLANNER_MODEL=
# 模型 fallback 链：主模型失败自动切备用（LangChain 保证同一份 messages 重试）。
# 留空 = 退回单端点（现状）。`AGENT_FALLBACK_*_URL/API_KEY` 留空 = 备用跟主端点走（同端点换模型）。
AGENT_FALLBACK_MODEL=
AGENT_FALLBACK_LIGHT_MODEL=
AGENT_FALLBACK_BASE_URL=
AGENT_FALLBACK_API_KEY=
# 备用端点不认 `enable_thinking` 时置 true（只影响备用那一节）
AGENT_FALLBACK_SKIP_THINKING=false
# 环内每 N 步注入一次"计划约束"提醒（0 = 关闭，默认关：当前 ReAct 多是一步即收）。
# ⚠️ 提醒走 user 侧，**不进 system**（system 一变 prompt cache 就整段失效）。
AGENT_REACT_STEP_REMIND_EVERY=0
# 环内每步水位超预算时**真的**压缩（默认 false = 只记录 warning，见 specs/0014 §8 Q1）
AGENT_REACT_MIDRUN_COMPRESS=false
# 扇出/环内并行的**并发许可门**（卡"同时在飞几个"，MAX_FANOUT 卡的是"一共发几个"）。
# ⚠️ 默认取 AGENT_MAX_FANOUT ⇒ 门恒不生效（安全默认值）。
AGENT_FANOUT_CONCURRENCY=8

# ============================================================================
# 运维：链路追踪（specs/0015）
# ============================================================================
# 请求头里有这个 ID 就用它（与上游 Gateway 对齐），没有就自生成并回写响应头。
AGENT_TRACE_HEADER=X-Trace-Id
AGENT_TRACE_ENABLED=true
# 🔴 checkpoint 不可用时**保持 fail-fast**（不加降级开关）：多实例回退 sqlite 会让同一
#    thread 状态分叉，且**不报错**（只是用户偶尔丢历史）⇒ 默认不提供该开关（specs/0015 §8 Q2）。
#    想本地调试请显式把 AGENT_CHECKPOINT_BACKEND 设成 sqlite。
